AUDIO_STORAGE_MODE=gcs
GCS_BUCKET=rebel-audio-previews
GCP_CREDENTIALS_PATH=secrets/gcp_service_account.json
YTDLP_PLAYER_CLIENTS=android,web
YTDLP_REFERER=https://www.youtube.com/
YTDLP_ORIGIN=https://www.youtube.com
YTDLP_COOKIES_PATH=secrets/youtube_cookies.txt
CLAP_CHECKPOINT_PATH=checkpoints/music_audioset_epoch_15_esc_90.14.pt
CLAP_AMODEL=HTSAT-base
CLAP_ENABLE_FUSION=false
CLAP_MODEL_NAME=clap-htsat-base
CLAP_MODEL_VERSION=1.0
EMBEDDING_SAMPLE_RATE=48000
CLAP_DEVICE=cpu
EMBEDDING_JOB_TIMEOUT=900
UMAP_RECALC_INTERVAL=10
UMAP_MAX_TRACKS=5000
# Keep CPU unless a deployment explicitly provides a supported GPU UMAP runtime.
UMAP_DEVICE=cpu
# Queues: run `python -m jobs.worker --queues analysis` and `--queues positioning` as two processes in production.
ANALYSIS_QUEUE_NAME=analysis
POSITION_QUEUE_NAME=positioning
# Audio features on the whole file (full, default) or on the 30 s CLAP segment (core, ~4x faster).
# Switching requires re-running audio_features for the whole catalogue.
AUDIO_FEATURES_SOURCE=full
UMAP_KNN_K=5
UMAP_KNN_MIN_NEIGHBORS=3
UMAP_KNN_MIN_SIMILARITY=0.01
UMAP_QUALITY_K=10
UMAP_MIN_TRUSTWORTHINESS=0.90
# Provisional until phase-4 corpus calibration; 0.70 remains the product target.
UMAP_MIN_NEIGHBOR_RECALL=0.35
QDRANT_SIMILARITY_TIMEOUT=5
SIMILARITY_MAX_CANDIDATES=1000
# Configure only after calibration against the REBEL validation corpus.
# SIMILARITY_VERY_CLOSE_THRESHOLD=0.90
# SIMILARITY_CLOSE_THRESHOLD=0.80
# SIMILARITY_RELATED_THRESHOLD=0.65
WS_EVENTS_CHANNEL=ws_events
# Optional; defaults to the system temporary directory.
# Persist numba JIT caches between worker restarts (first UMAP call otherwise spends ~10 s compiling).
# NUMBA_CACHE_DIR=/tmp/rebel-numba-cache
