NODE_ENV=development
PORT=5001
API_PUBLIC_URL=http://localhost:5001

MONGO_URI=mongodb://localhost:27017/rebel

JWT_SECRET=replace_me_with_a_secure_secret
JWT_EXPIRE=30d

PIPELINE_API_URL=http://localhost:8000

MAGIC_PUBLISHABLE_KEY=pk_live_DAE97419AE6EBC48
MAGIC_SECRET_KEY=sk_live_62123A40F26C62D1

SOLANA_NETWORK=devnet
ADMIN_PRIVATE_KEY=2xLTRMM2L7QLGoKNPmBCLNjXeHRk5pHz8GRC5hq3hFeLVBk2nRcRktad7wVRzaDz7B7MM9kv1zyCp5rangvrj6kV

# Audio asset provenance worker
AUDIO_STORAGE_MODE=local
AUDIO_STORAGE_ROOT=storage/audio_previews
# AUDIO_STORAGE_S3_BUCKET=
# AUDIO_STORAGE_S3_REGION=
# GCS_BUCKET=rebel-audio-previews
# GCP_CREDENTIALS_PATH=music-pipeline/secrets/gcp_service_account.json
AUDIO_ASSET_FETCH_LIMIT=10
AUDIO_ASSET_MAX_ATTEMPTS=5
AUDIO_ASSET_POLL_INTERVAL=30
AUDIO_PREVIEW_CONNECT_TIMEOUT=15
AUDIO_PREVIEW_DOWNLOAD_TIMEOUT=300

# Job queue (Python pipeline)
REDIS_URL=redis://localhost:6379/0
ANALYSIS_QUEUE_NAME=analysis

# Embeddings / vector store
CLAP_AMODEL=HTSAT-tiny
CLAP_ENABLE_FUSION=false
CLAP_MODEL_NAME=clap-htsat-base
CLAP_MODEL_VERSION=1.0
# CLAP_CHECKPOINT_PATH=/absolute/path/to/clap.pt
EMBEDDING_SAMPLE_RATE=48000
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=music_embeddings
# QDRANT_API_KEY=
JOB_TIMEOUT_DEFAULT=300
EMBEDDING_JOB_TIMEOUT=900

# YouTube preview fetching (yt-dlp)
YTDLP_FORMAT=bestaudio/best
YTDLP_AUDIO_FORMAT=mp3
YTDLP_PLAYER_CLIENTS=android
# YTDLP_COOKIES_PATH=music-pipeline/secrets/youtube_cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_REFERER=https://www.youtube.com/
# YTDLP_ORIGIN=https://www.youtube.com
# YTDLP_PROXY=socks5://user:pass@127.0.0.1:1080
# YTDLP_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 13_5_1) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
# YTDLP_IMPERSONATE=chrome
COBALT_PREVIEW_DURATION_SECONDS=0 # set >0 (30-60) to trim previews, 0 stores full downloads
YOUTUBE_SEARCH_TIMEOUT=15
YOUTUBE_SEARCH_ACCEPT_LANGUAGE=en-US,en;q=0.9
YOUTUBE_SEARCH_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 13_5_1) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
